# Internal container ports are fixed (postgres 5432, ledger 4100, backend 4000, frontend 80).
# The *_HOST_PORT vars below only control what's published on your machine — change these
# if the defaults collide with something else you have running locally.

# --- Postgres ---
POSTGRES_USER=sixsync
POSTGRES_PASSWORD=sixsync_dev_password
POSTGRES_DB=sixsync
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://sixsync:sixsync_dev_password@postgres:5432/sixsync

# --- Ledger service ---
LEDGER_HOST_PORT=4100
LEDGER_URL=http://ledger:4100
LEDGER_DEBUG_ENDPOINTS=true

# --- Backend ---
BACKEND_HOST_PORT=4000
JWT_SECRET=dev_jwt_secret_change_me
CORS_ORIGIN=http://localhost:3000

# --- Optional LLM enrichment (leave unset / false to run fully offline) ---
ENABLE_LLM_ENRICHMENT=false
ANTHROPIC_API_KEY=

# --- Optional threat-intel enrichment (AbuseIPDB abuse score + ip-api.com geolocation; leave false to run fully offline) ---
ENABLE_TI_ENRICHMENT=false
ABUSEIPDB_API_KEY=

# --- Email alerts (CRITICAL reports + new campaigns) ---
# Under docker-compose this is wired to the "mailpit" service by default (ENABLE_EMAIL_ALERTS=true,
# SMTP_HOST=mailpit, SMTP_PORT=1025) — no setup needed, alerts just show up at http://localhost:8025.
# Mailpit doesn't validate recipient domains, so the seeded orgs' fake .demo addresses work fine.
# Leave the vars below unset to keep that default. Set them (or run backend outside docker) to
# point at a real SMTP provider instead — in that case ENABLE_EMAIL_ALERTS must be true too, or
# alerts just get logged as "would send" to the backend console instead of actually emailing anyone.
MAILPIT_HOST_PORT=8025
ENABLE_EMAIL_ALERTS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# If set, every alert goes to this single address instead of each org's registered email —
# only useful once you're pointed at a real SMTP provider, not needed for mailpit.
ALERT_EMAIL_OVERRIDE=

# --- Frontend ---
FRONTEND_HOST_PORT=3000
# Must match BACKEND_HOST_PORT / FRONTEND_HOST_PORT above (browser-facing, not internal).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
