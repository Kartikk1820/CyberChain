# Internal container ports are fixed (postgres 5432, ledger 4100, backend 4000, frontend 80).
# The *_HOST_PORT vars below only control what's published on your machine — change these
# if the defaults collide with something else you have running locally.

# --- Postgres ---
POSTGRES_USER=sixsync
POSTGRES_PASSWORD=sixsync_dev_password
POSTGRES_DB=sixsync
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://sixsync:sixsync_dev_password@postgres:5432/sixsync

# --- Ledger service ---
LEDGER_HOST_PORT=4100
LEDGER_URL=http://ledger:4100
LEDGER_DEBUG_ENDPOINTS=true

# --- Backend ---
BACKEND_HOST_PORT=4000
JWT_SECRET=dev_jwt_secret_change_me
CORS_ORIGIN=http://localhost:3000

# --- Optional LLM enrichment (leave unset / false to run fully offline) ---
ENABLE_LLM_ENRICHMENT=false
ANTHROPIC_API_KEY=

# --- Optional threat-intel enrichment (AbuseIPDB abuse score + ip-api.com geolocation; leave false to run fully offline) ---
ENABLE_TI_ENRICHMENT=false
ABUSEIPDB_API_KEY=

# --- Frontend ---
FRONTEND_HOST_PORT=3000
# Must match BACKEND_HOST_PORT / FRONTEND_HOST_PORT above (browser-facing, not internal).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
